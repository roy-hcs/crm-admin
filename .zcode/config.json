{
  "hooks": {
    "enabled": true,
    "events": {
      "Stop": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": ["${ZCODE_PROJECT_DIR}/.zcode/hooks/auto-continue.cjs"],
              "timeoutMs": 300000,
              "statusMessage": "检测系统繁忙，准备自动续跑"
            }
          ]
        }
      ]
    }
  }
}
